# PostgreSQL connection string for production persistence.
DATABASE_URL="postgresql://user:password@host:5432/tracker?schema=public"

# Generate a long random value and never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated public frontend origins, without a trailing slash.
CORS_ORIGINS="https://tracker.example.com"

# Seed-only JSON array. Remove this after running `npm run prisma:seed` in production.
SEED_ACCOUNTS_JSON='[{"id":"admin-1","email":"admin@example.com","password":"replace-admin-password","name":"Operations Admin","role":"admin","vehicleNumber":"","phoneNumber":""},{"id":"driver-1","email":"rider@example.com","password":"replace-driver-password","name":"Delivery Rider","role":"driver","vehicleNumber":"BIKE-001","phoneNumber":""},{"id":"driver-2","email":"rider2@example.com","password":"replace-second-rider-password","name":"Delivery Rider Two","role":"driver","vehicleNumber":"BIKE-002","phoneNumber":""}]'

# Optional completed routes shown in the admin map after seeding.
SEED_JOURNEYS_JSON='[{"id":"demo-journey-1","userId":"driver-1","name":"Delivery Rider","vehicleNumber":"BIKE-001","startedAt":"2026-09-15T08:00:00.000Z","endedAt":"2026-09-15T08:35:00.000Z","active":false,"points":[{"latitude":-1.9441,"longitude":30.0619,"timestamp":"2026-09-15T08:00:00.000Z"},{"latitude":-1.9462,"longitude":30.0648,"timestamp":"2026-09-15T08:08:00.000Z"},{"latitude":-1.9494,"longitude":30.0681,"timestamp":"2026-09-15T08:17:00.000Z"},{"latitude":-1.9521,"longitude":30.0724,"timestamp":"2026-09-15T08:26:00.000Z"},{"latitude":-1.9552,"longitude":30.0768,"timestamp":"2026-09-15T08:35:00.000Z"}]},{"id":"demo-journey-2","userId":"driver-1","name":"Delivery Rider","vehicleNumber":"BIKE-001","startedAt":"2026-09-15T10:00:00.000Z","endedAt":"2026-09-15T10:28:00.000Z","active":false,"points":[{"latitude":-1.9552,"longitude":30.0768,"timestamp":"2026-09-15T10:00:00.000Z"},{"latitude":-1.9518,"longitude":30.0801,"timestamp":"2026-09-15T10:07:00.000Z"},{"latitude":-1.9483,"longitude":30.0835,"timestamp":"2026-09-15T10:14:00.000Z"},{"latitude":-1.9447,"longitude":30.0861,"timestamp":"2026-09-15T10:21:00.000Z"},{"latitude":-1.9412,"longitude":30.0890,"timestamp":"2026-09-15T10:28:00.000Z"}]}]'

