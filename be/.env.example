# PostgreSQL connection string for production persistence.
DATABASE_URL="postgresql://user:password@host:5432/tracker?schema=public"

# Generate a long random value and never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated public frontend origins, without a trailing slash.
CORS_ORIGINS="https://tracker.example.com"

# Seed-only JSON array. Remove this after running `npm run prisma:seed` in production.
SEED_ACCOUNTS_JSON='[{"id":"admin-1","email":"admin@example.com","password":"replace-admin-password","name":"Operations Admin","role":"admin","vehicleNumber":"","phoneNumber":""},{"id":"driver-1","email":"rider@example.com","password":"replace-driver-password","name":"Delivery Rider","role":"driver","vehicleNumber":"BIKE-001","phoneNumber":""}]'

PORT=4000
SERVER_PUBLIC_URL="http://localhost:4000"
